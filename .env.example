ADMIN_PASSWORD=replace-with-a-long-random-password
COOKIE_SECURE=true
IMPORT_PATH=./imports
# Web server timezone for the daily photo, e.g. Asia/Shanghai.
TZ=UTC

FEEDBACK_RATE_LIMIT_PER_MINUTE=5
FEEDBACK_RATE_LIMIT_PER_DAY=50
# Only trust actual reverse proxy addresses/networks; never use * on an exposed backend.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Single API process admission limits (burst: per-IP 120, global 200).
REQUEST_RATE_PER_SECOND=10
REQUEST_GLOBAL_RATE_PER_SECOND=50
REQUEST_MAX_CONCURRENCY=64

# Seconds to wait for media recovery; ZIP preflight allows up to 3x. 0 skips waiting.
MEDIA_CACHE_WAIT_SECONDS=10

# CPU detection/matching slots; downloads and imports share a separate slot.
WORKER_CONCURRENCY=auto
# Release cached models after this many idle seconds; 0 disables reclamation.
WORKER_IDLE_TIMEOUT_SECONDS=300

# Optional, per filesystem. Set both to enable eviction (e.g. 5 and 10).
# Remote-only originals may become unrecoverable if the source disappears.
MEDIA_CACHE_LOW_FREE_GIB=
MEDIA_CACHE_TARGET_FREE_GIB=
# Minimum idle hours before eviction; 0 disables recent-use protection.
MEDIA_CACHE_MIN_IDLE_HOURS=24
